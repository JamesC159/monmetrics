PORT=8080
MONGODB_URI=mongodb://localhost:27017
DB_NAME=monmetrics
JWT_SECRET=your-super-secret-jwt-key-change-this
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60s
ENVIRONMENT=development

# Marketplace integration (only "mock" is implemented)
MARKETPLACE_MODE=mock
# base64-encoded 32 bytes, e.g. `openssl rand -base64 32`; required in production
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Price alerts (evaluated on a background ticker)
ALERTS_ENABLED=true
ALERT_EVAL_INTERVAL=15m
# Email delivery via SMTP with STARTTLS (e.g. port 587); leave SMTP_HOST empty to log emails instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MonMetrics <alerts@monmetrics.local>

# Seeder test user (defaults to the existing "xx xx" account)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
